{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/",
        "destination": "/home.html",
        "regex": "^/(?:/)?$"
      },
      {
        "source": "/:page((?!api|_next|assets|styles|scripts|images|admin).*)",
        "destination": "/:page.html",
        "regex": "^(?:/((?!api|_next|assets|styles|scripts|images|admin).*))(?:/)?$"
      },
      {
        "source": "/admin/:page",
        "destination": "/admin/:page.html",
        "regex": "^/admin(?:/([^/]+?))(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
